# Vercel の Storage で作成した Postgres（Neon）の接続情報。
# `vercel env pull .env.local` で取得できる（.env.local が .env より優先される）。
POSTGRES_URL=
# マイグレーション用のプールを経由しない接続。未設定なら POSTGRES_URL を使う。
POSTGRES_URL_NON_POOLING=

# 結合テスト・E2E専用のDB（Neonのテスト用ブランチなど）。本番・開発と同じDBは拒否される。
# Vercel の環境変数には登録しない。
TEST_POSTGRES_URL=

# `openssl rand -base64 32`。Vercel にも環境変数として登録する。
AUTH_SECRET=
# ローカル開発用。Vercel 上では設定しない（自動で判定される）。
AUTH_URL=http://localhost:3000/api/auth

# 画像の保存先（Vercel Blob の非公開ストア）。開発・本番・テストで別のストアにする。
# 開発用は .env.development.local に書く。サーバーだけで使い、NEXT_PUBLIC は付けない。
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# 結合テスト・E2E専用の非公開Blobストア。アプリ用と同じストアは拒否される。
TEST_BLOB_READ_WRITE_TOKEN=
TEST_BLOB_STORE_ID=

# 画像回収のCron（/api/cron/media-cleanup）の認証用。Vercel にも登録する。
CRON_SECRET=
